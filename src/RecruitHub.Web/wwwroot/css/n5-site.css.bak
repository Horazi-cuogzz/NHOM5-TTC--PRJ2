:root {
  --n5-blue: #2463eb;
  --n5-blue-dark: #164cbe;
  --n5-ink: #142544;
  --n5-muted: #687891;
  --n5-border: #e1e8f2;
  --n5-bg: #f7f9fc;
  --bs-primary: #2463eb;
  --bs-link-color: #2463eb;
}
* {
  box-sizing: border-box;
}
body {
  font-family: "Segoe UI", Arial, sans-serif;
  color: var(--n5-ink);
  background: var(--n5-bg);
  font-size: 15px;
  line-height: 1.65;
  margin: 0;
}
a {
  color: var(--n5-blue);
  text-decoration: none;
}
a:hover {
  color: var(--n5-blue-dark);
}
button,
input,
select,
textarea {
  font: inherit;
}
h1,
h2,
h3,
h4 {
  color: var(--n5-ink);
  letter-spacing: -0.035em;
  font-weight: 750;
  line-height: 1.25;
}
h1 {
  font-size: 36px;
}
h2 {
  font-size: 27px;
}
h3 {
  font-size: 18px;
}
p {
  margin-bottom: 1rem;
}
main {
  min-height: calc(100vh - 180px);
}
.n5-container {
  width: min(1280px, calc(100% - 80px));
  margin-inline: auto;
}
.btn {
  font-weight: 600;
  border-radius: 8px;
  padding: 11px 20px;
  line-height: 1.5;
  font-size: 14px;
  white-space: nowrap;
}
.btn-primary {
  --bs-btn-bg: var(--n5-blue);
  --bs-btn-border-color: var(--n5-blue);
  --bs-btn-hover-bg: var(--n5-blue-dark);
  --bs-btn-hover-border-color: var(--n5-blue-dark);
  --bs-btn-active-bg: var(--n5-blue-dark);
}
.btn-outline-primary {
  --bs-btn-color: var(--n5-blue);
  --bs-btn-border-color: #bed1fb;
  --bs-btn-hover-bg: var(--n5-blue);
  --bs-btn-hover-border-color: var(--n5-blue);
}
.btn-light {
  background: #f0f4fa;
  border-color: #e5ebf4;
  color: var(--n5-ink);
}
.btn-sm {
  padding: 7px 11px;
  font-size: 13px;
}
.btn span {
  margin-left: 8px;
}
.form-control,
.form-select {
  border: 1px solid #d7e0ed;
  border-radius: 8px;
  padding: 11px 13px;
  font-size: 14px;
  color: var(--n5-ink);
}
.form-control:focus,
.form-select:focus {
  border-color: #86afff;
  box-shadow: 0 0 0 3px #2463eb15;
}
.form-label {
  font-size: 14px;
  font-weight: 600;
}
.field-validation-error {
  color: #ba3248;
  display: block;
  font-size: 13px;
  margin-top: 4px;
}
.validation-summary-valid {
  display: none;
}
.validation-summary-errors {
  background: #fff2f3;
  padding: 14px;
  border-radius: 8px;
  margin-bottom: 18px;
}
.validation-summary-errors ul {
  margin: 0;
  padding-left: 18px;
}
.input-validation-error {
  border-color: #cf5063;
}
.n5-skip {
  position: absolute;
  left: 16px;
  top: -80px;
  background: white;
  padding: 10px;
  z-index: 100;
}
.n5-skip:focus {
  top: 12px;
}
:focus-visible {
  outline: 3px solid #7fa9ff;
  outline-offset: 3px;
}
.n5-header {
  background: #fff;
  border-bottom: 1px solid var(--n5-border);
  position: relative;
  z-index: 20;
}
.n5-header .navbar {
  min-height: 88px;
  padding: 12px 0;
  gap: 30px;
}
.n5-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 25px;
  font-weight: 800;
  color: var(--n5-ink);
  line-height: 1.05;
  letter-spacing: -1px;
}
.n5-brand > span > span {
  color: var(--n5-blue);
}
.n5-brand small {
  display: block;
  letter-spacing: 1.8px;
  font-size: 8px;
  font-weight: 650;
  color: #8a97ac;
  margin-top: 8px;
}
.n5-mark {
  display: grid;
  place-content: center;
  width: 42px;
  height: 45px;
  background: var(--n5-blue);
  color: #fff;
  position: relative;
  font-size: 26px;
  letter-spacing: -3px;
  border-radius: 12px 12px 4px 12px;
  padding-right: 3px;
  display: inline-block;
  text-align: center;
  line-height: 44px;
}
.n5-mark span {
  color: #c8d9ff;
}
.navbar-nav {
  gap: 18px;
}
.navbar-nav .nav-link {
  color: #53637c;
  padding: 14px 2px !important;
  font-weight: 600;
  font-size: 14px;
  position: relative;
}
.navbar-nav .nav-link.active {
  color: var(--n5-blue);
}
.navbar-nav .nav-link.active:after {
  content: "";
  position: absolute;
  height: 3px;
  border-radius: 9px;
  bottom: 3px;
  left: 2px;
  right: 2px;
  background: var(--n5-blue);
}
.n5-account {
  display: flex;
  align-items: center;
  gap: 20px;
}
.n5-login-link {
  font-size: 14px;
  font-weight: 650;
  color: var(--n5-ink);
}
.n5-avatar-button {
  border: 0;
  background: none;
  display: flex;
  gap: 10px;
  align-items: center;
  color: var(--n5-ink);
  font-size: 13px;
}
.n5-avatar {
  width: 38px;
  height: 38px;
  background: #edf3ff;
  display: grid;
  place-content: center;
  color: var(--n5-blue);
  border: 1px solid #dae6ff;
  border-radius: 50%;
  font-weight: 750;
}
.n5-role {
  max-width: 104px;
}
.dropdown-menu {
  border-color: var(--n5-border);
  box-shadow: 0 12px 30px #14254415;
  border-radius: 10px;
}
.n5-hero {
  background: linear-gradient(115deg, #f2f7ff 0%, #e9f2ff 62%, #edf5ff 100%);
  border-bottom: 1px solid #e0eaf8;
  overflow: hidden;
  position: relative;
}
.n5-hero:after {
  content: "";
  position: absolute;
  width: 530px;
  height: 530px;
  border: 1px solid #dce8fb80;
  border-radius: 50%;
  right: -160px;
  top: -260px;
  pointer-events: none;
}
.n5-hero-grid {
  display: grid;
  grid-template-columns: 1.65fr 1fr;
  align-items: center;
  min-height: 450px;
  gap: 22px;
  padding-top: 44px;
  padding-bottom: 42px;
  position: relative;
  z-index: 1;
}
.n5-eyebrow {
  font-size: 10px;
  letter-spacing: 1.7px;
  font-weight: 750;
  color: #6681aa;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.n5-eyebrow > span:empty {
  width: 6px;
  height: 6px;
  background: var(--n5-blue);
  border-radius: 50%;
  box-shadow: 0 0 0 4px #2463eb13;
}
.n5-hero h1 {
  font-size: clamp(35px, 3.2vw, 48px);
  line-height: 1.19;
  letter-spacing: -1.9px;
  margin-bottom: 18px;
  font-weight: 780;
}
.n5-hero h1 em {
  font-style: normal;
  color: var(--n5-blue);
}
.n5-hero-copy > p {
  font-size: 16px;
  color: #6b7c98;
  line-height: 1.7;
  margin-bottom: 27px;
}
.n5-search {
  display: flex;
  background: #fff;
  padding: 8px;
  border: 1px solid #dee7f5;
  border-radius: 11px;
  box-shadow: 0 6px 24px #3569b10b;
  align-items: center;
  gap: 6px;
}
.n5-search-keyword {
  display: flex;
  gap: 11px;
  align-items: center;
  flex: 1;
  min-width: 0;
  padding-left: 12px;
}
.n5-search-keyword > span {
  font-size: 30px;
  line-height: 1;
  color: #7184a2;
  transform: rotate(-18deg);
}
.n5-search input {
  border: 0;
  outline: 0;
  width: 100%;
  background: none;
  font-size: 13px;
  min-width: 0;
}
.n5-search input::placeholder {
  color: #7a8aa3;
}
.n5-search-location {
  border-left: 1px solid #e4eaf3;
  display: flex;
  align-items: center;
  padding-left: 13px;
  max-width: 205px;
  gap: 7px;
  min-width: 0;
}
.n5-search-location > span {
  color: #788aa3;
  font-size: 23px;
}
.n5-search select {
  border: 0;
  outline: 0;
  background: none;
  width: 100%;
  font-size: 13px;
  color: #50627f;
  min-width: 0;
  padding: 4px;
}
.n5-search .btn {
  font-size: 13px;
  padding: 13px 19px;
  flex-shrink: 0;
}
.n5-popular {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-top: 17px;
  flex-wrap: wrap;
  font-size: 11px;
  color: #7386a1;
}
.n5-popular a {
  background: #ffffff95;
  padding: 4px 10px;
  border: 1px solid #d8e6f8;
  border-radius: 6px;
  font-weight: 600;
  font-size: 11px;
  color: #4a6b9d;
}
.n5-popular a span {
  margin-left: 7px;
  color: #92a8c8;
}
.n5-hero-art {
  height: 330px;
  position: relative;
}
.n5-orbit {
  position: absolute;
  border: 1px dashed #aac4ed70;
  border-radius: 50%;
  width: 310px;
  height: 310px;
  top: 2px;
  left: 50px;
}
.n5-orbit-two {
  width: 370px;
  height: 370px;
  left: 20px;
  top: -30px;
  opacity: 0.7;
}
.n5-art-browser {
  position: absolute;
  left: 40px;
  top: 39px;
  width: 320px;
  background: #fff;
  box-shadow: 0 20px 45px #265aad16;
  border: 1px solid #d7e5fb;
  border-radius: 13px;
  transform: rotate(-5deg);
  padding-bottom: 18px;
}
.n5-browser-bar {
  height: 35px;
  background: #f5f8fe;
  border-bottom: 1px solid #e5edf9;
  border-radius: 13px 13px 0 0;
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 0 13px;
}
.n5-browser-bar i {
  background: #cdd9eb;
  width: 5px;
  height: 5px;
  border-radius: 50%;
}
.n5-browser-bar span {
  font-size: 8px;
  color: #9baac0;
  margin-left: 10px;
  letter-spacing: 0.5px;
}
.n5-art-heading {
  display: flex;
  gap: 10px;
  align-items: center;
  margin: 21px 21px 17px;
}
.n5-art-logo {
  display: grid;
  place-content: center;
  background: #eaf1ff;
  color: var(--n5-blue);
  width: 38px;
  height: 40px;
  border-radius: 9px;
  font-size: 21px;
  font-weight: 800;
}
.n5-art-heading b {
  font-size: 13px;
}
.n5-art-heading small {
  display: block;
  font-size: 9px;
  color: #92a1b9;
  margin-top: 3px;
}
.n5-art-lines {
  margin: 0 21px;
}
.n5-art-lines i {
  display: block;
  height: 5px;
  border-radius: 5px;
  background: #edf2f9;
  margin-bottom: 9px;
  width: 100%;
}
.n5-art-lines i:nth-child(2) {
  width: 82%;
}
.n5-art-lines i:nth-child(3) {
  width: 65%;
}
.n5-art-tags {
  display: flex;
  gap: 6px;
  margin: 16px 21px;
}
.n5-art-tags span {
  font-size: 9px;
  border-radius: 4px;
  padding: 3px 8px;
  background: #edf3ff;
  color: #5e7dab;
}
.n5-art-check {
  display: flex;
  align-items: center;
  gap: 8px;
  background: #edf9f3;
  color: #23946a;
  font-size: 11px;
  margin: 0 20px;
  padding: 9px 11px;
  border-radius: 7px;
}
.n5-art-check b {
  margin-left: auto;
}
.n5-floating {
  position: absolute;
  border: 1px solid #fff9;
  box-shadow: 0 12px 24px #2356a417;
  display: grid;
  place-items: center;
  font-weight: 750;
}
.n5-floating-csharp {
  right: 5px;
  top: 4px;
  width: 67px;
  height: 67px;
  border-radius: 16px;
  background: var(--n5-blue);
  color: white;
  font-size: 25px;
  transform: rotate(10deg);
}
.n5-floating-react {
  left: 4px;
  bottom: 44px;
  display: flex;
  gap: 7px;
  padding: 12px 17px;
  border-radius: 12px;
  background: white;
  font-size: 15px;
  transform: rotate(-9deg);
  color: #4a70b0;
}
.n5-floating-react span {
  color: #6ca4f5;
  font-size: 23px;
}
.n5-floating-profile {
  position: absolute;
  bottom: 1px;
  right: -3px;
  display: flex;
  align-items: center;
  gap: 10px;
  border: 1px solid #dce7f8;
  border-radius: 12px;
  padding: 15px 16px;
  background: #fff;
  box-shadow: 0 15px 25px #325b9c16;
  transform: rotate(4deg);
}
.n5-floating-profile strong {
  display: block;
  font-size: 11px;
}
.n5-floating-profile small {
  display: block;
  color: #92a2bb;
  font-size: 9px;
}
.n5-floating-profile > span {
  margin-left: 13px;
  border-radius: 50%;
  background: #e8f6ee;
  color: #30956a;
  width: 21px;
  text-align: center;
  font-size: 11px;
}
.n5-art-avatar {
  border-radius: 50%;
  background: #eaf1ff;
  color: #4a7ce0;
  display: grid;
  place-content: center;
  font-size: 24px;
  width: 38px;
  height: 38px;
}
.n5-art-caption {
  position: absolute;
  font-size: 7px;
  letter-spacing: 1.3px;
  color: #94acd0;
  bottom: -26px;
  left: 85px;
}
.n5-home-jobs {
  padding-top: 43px;
  padding-bottom: 40px;
}
.n5-section-heading {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  align-items: center;
  margin-bottom: 27px;
}
.n5-section-heading .n5-eyebrow {
  margin-bottom: 9px;
  font-size: 9px;
  letter-spacing: 1.6px;
}
.n5-section-heading h2 {
  margin: 0 0 8px;
  font-size: 28px;
}
.n5-section-heading p {
  margin: 0;
  color: var(--n5-muted);
  font-size: 14px;
}
.n5-text-link {
  font-weight: 650;
  font-size: 13px;
  white-space: nowrap;
}
.n5-text-link span {
  margin-left: 8px;
}
.n5-content-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 290px;
  gap: 25px;
  align-items: start;
}
.n5-job-list {
  display: grid;
  gap: 14px;
}
.n5-job-card {
  background: white;
  border: 1px solid var(--n5-border);
  border-radius: 11px;
  padding: 22px;
  display: flex;
  gap: 17px;
  transition:
    border-color 0.15s,
    box-shadow 0.15s;
}
.n5-job-card:hover {
  border-color: #b3caff;
  box-shadow: 0 5px 18px #2b528008;
}
.n5-company-icon {
  background: linear-gradient(135deg, #f0f5ff, #e2edff);
  color: var(--n5-blue);
  width: 50px;
  height: 54px;
  flex-shrink: 0;
  display: grid;
  place-content: center;
  border-radius: 10px;
  font-size: 27px;
  font-weight: 800;
  line-height: 1;
  border: 1px solid #e4ebf7;
}
.n5-job-content {
  flex: 1;
  min-width: 0;
}
.n5-job-top {
  display: flex;
  justify-content: space-between;
  gap: 10px;
}
.n5-job-top h3 {
  margin: 0 0 5px;
  font-size: 17px;
}
.n5-job-top h3 a {
  color: var(--n5-ink);
}
.n5-company-name {
  margin: 0;
  font-size: 12px;
  color: #72819a;
}
.n5-open {
  font-size: 9px;
  white-space: nowrap;
  color: #62937d;
  background: #f2faf6;
  padding: 2px 7px;
  height: fit-content;
  display: flex;
  align-items: center;
  gap: 5px;
  border-radius: 5px;
  margin-top: 2px;
}
.n5-open span {
  width: 4px;
  height: 4px;
  background: #47a779;
  border-radius: 50%;
}
.n5-job-meta {
  display: flex;
  gap: 15px;
  flex-wrap: wrap;
  font-size: 11px;
  color: #7787a1;
  margin: 10px 0 0;
}
.n5-salary {
  color: #42678f;
  font-weight: 600;
}
.n5-job-meta > span > span {
  margin-right: 3px;
}
.n5-job-bottom {
  display: flex;
  gap: 16px;
  align-items: center;
  margin-top: 17px;
  padding-top: 15px;
  border-top: 1px solid #f0f3f8;
}
.n5-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.n5-chip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: #edf3ff;
  color: #3b66a9;
  font-size: 10px;
  font-weight: 600;
  border-radius: 5px;
  padding: 4px 9px;
  line-height: 1.6;
}
.n5-chip-green {
  color: #2b8b68;
  background: #eaf7f0;
}
.n5-chip-muted {
  color: #8c6c47;
  background: #fbf3e8;
}
.n5-match {
  display: flex;
  align-items: center;
  gap: 9px;
  min-width: 143px;
}
.n5-match-ring {
  --score: 0;
  background: conic-gradient(var(--n5-blue) calc(var(--score) * 1%), #e9eef6 0);
  border-radius: 50%;
  height: 47px;
  width: 47px;
  display: grid;
  place-content: center;
  flex-shrink: 0;
  position: relative;
}
.n5-match-ring:before {
  content: "";
  position: absolute;
  inset: 4px;
  background: #fff;
  border-radius: 50%;
}
.n5-match-ring > span {
  position: relative;
  z-index: 1;
  font-size: 11px;
  letter-spacing: -0.4px;
  font-weight: 800;
}
.n5-match-ring small {
  font-size: 8px;
}
.n5-match strong {
  font-size: 11px;
  white-space: nowrap;
}
.n5-match > div > small {
  display: block;
  color: #8c99ac;
  font-size: 9px;
}
.n5-matching-skills {
  display: flex;
  gap: 14px;
  flex: 1;
  min-width: 0;
}
.n5-matching-skills > div > small {
  font-size: 9px;
  color: #98a2b3;
  margin-bottom: 4px;
  display: block;
}
.n5-matching-skills .n5-chip {
  font-size: 9px;
  padding: 3px 6px;
}
.n5-detail-link {
  margin-left: auto;
  font-size: 10px;
  padding: 8px 10px;
}
.n5-profile-aside {
  background: #fff;
  border: 1px solid var(--n5-border);
  border-radius: 11px;
  padding: 24px;
}
.n5-aside-top {
  font-size: 9px;
  letter-spacing: 1.2px;
  color: #8397b6;
  display: flex;
  gap: 10px;
  align-items: center;
  margin-bottom: 20px;
  font-weight: 700;
}
.n5-small-icon {
  width: 28px;
  height: 28px;
  border-radius: 7px;
  background: #edf3ff;
  display: grid;
  place-content: center;
  color: #5078bf;
  font-size: 21px;
}
.n5-profile-aside h3 {
  font-size: 19px;
  margin-bottom: 10px;
}
.n5-profile-aside p {
  font-size: 12px;
  color: #8a97aa;
  line-height: 1.8;
}
.n5-profile-aside .btn {
  font-size: 12px;
}
.n5-note {
  border-top: 1px solid #e8edf4;
  padding-top: 17px;
  margin-top: 21px;
  display: flex;
  align-items: start;
  gap: 8px;
  font-size: 11px;
  color: #8c9aaf;
  line-height: 1.7;
}
.n5-example-skills {
  display: flex;
  gap: 5px;
  margin: 16px 0 22px;
}
.n5-example-skills span {
  background: #f2f5fa;
  color: #8e9db2;
  font-size: 10px;
  border-radius: 5px;
  padding: 5px 8px;
}
.n5-how {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 40px;
  border-top: 1px solid var(--n5-border);
  padding-top: 28px;
  padding-bottom: 40px;
}
.n5-how > div {
  position: relative;
  padding-left: 45px;
}
.n5-how > div > span {
  position: absolute;
  left: 0;
  top: 0;
  font-size: 16px;
  font-weight: 700;
  color: #c0cee3;
}
.n5-how h3 {
  font-size: 14px;
  margin-bottom: 5px;
}
.n5-how p {
  font-size: 11px;
  color: #8a97ad;
  margin: 0;
}
.n5-footer {
  background: #fff;
  border-top: 1px solid var(--n5-border);
  padding: 25px 0;
  color: #8c99ad;
  font-size: 11px;
}
.n5-footer strong {
  color: #5c6d86;
  margin-right: 8px;
}
.n5-footer-dot {
  margin: 0 8px;
  color: #b3c0d4;
}
.n5-page {
  padding-top: 38px;
  padding-bottom: 60px;
}
.n5-page-banner {
  padding: 38px 0;
  background: #eaf2ff;
  border-bottom: 1px solid #dce7fa;
}
.n5-page-banner p {
  color: var(--n5-muted);
}
.n5-page-banner .n5-search {
  max-width: 880px;
  margin-top: 25px;
}
.n5-filter-row {
  display: flex;
  gap: 12px;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25px;
  flex-wrap: wrap;
}
.n5-filter-row strong {
  font-size: 15px;
}
.n5-panel {
  background: #fff;
  border: 1px solid var(--n5-border);
  border-radius: 12px;
  padding: 29px;
  min-width: 0;
}
.n5-panel h2 {
  font-size: 22px;
  margin-bottom: 22px;
}
.n5-panel h3 {
  font-size: 16px;
}
.n5-panel p {
  color: var(--n5-muted);
  font-size: 14px;
}
.n5-prose {
  white-space: pre-line;
  overflow-wrap: anywhere;
  color: #566981;
  font-size: 14px;
  line-height: 1.9;
}
.n5-back {
  display: inline-block;
  color: #74859e;
  margin-bottom: 24px;
  font-size: 13px;
}
.n5-detail-header {
  display: flex;
  align-items: center;
  gap: 24px;
  margin-bottom: 30px;
  background: #fff;
  border: 1px solid var(--n5-border);
  border-radius: 12px;
  padding: 30px;
}
.n5-detail-header h1 {
  margin-bottom: 8px;
}
.n5-detail-header p {
  margin-bottom: 5px;
  color: var(--n5-muted);
}
.n5-detail-header .n5-eyebrow {
  margin-bottom: 7px;
}
.n5-detail-header .n5-job-meta {
  font-size: 13px;
}
.n5-company-icon-lg {
  width: 80px;
  height: 86px;
  font-size: 43px;
}
.n5-apply-panel {
  position: sticky;
  top: 25px;
}
.n5-apply-panel h3 {
  font-size: 18px;
}
.n5-apply-panel > small {
  font-size: 11px;
  color: #8191a8;
}
.n5-big-score {
  font-size: 43px;
  color: var(--n5-blue);
  font-weight: 800;
  letter-spacing: -2px;
  line-height: 1.2;
  margin-bottom: 12px;
}
.n5-big-score span {
  font-size: 22px;
}
.n5-empty {
  padding: 55px 30px;
  text-align: center;
  background: #fff;
  border: 1px dashed #d4e0f1;
  border-radius: 12px;
}
.n5-empty > span {
  display: block;
  font-size: 38px;
  color: #a8bddf;
  margin-bottom: 10px;
  font-weight: 700;
}
.n5-empty h2,
.n5-empty h3 {
  font-size: 23px;
}
.n5-empty p {
  color: var(--n5-muted);
  font-size: 14px;
  max-width: 480px;
  margin: 12px auto 20px;
}
.n5-pagination {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-top: 28px;
  flex-wrap: wrap;
}
.n5-pagination a {
  border: 1px solid var(--n5-border);
  width: 36px;
  height: 36px;
  display: grid;
  place-content: center;
  border-radius: 7px;
  background: white;
  font-weight: 600;
  font-size: 13px;
}
.n5-pagination a.active {
  background: var(--n5-blue);
  color: #fff;
  border-color: var(--n5-blue);
}
.n5-form-wide {
  max-width: 850px;
}
.n5-form-narrow {
  max-width: 520px;
}
.n5-skill-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 15px;
}
.n5-skill-picker label {
  cursor: pointer;
  position: relative;
}
.n5-skill-picker input {
  position: absolute;
  opacity: 0;
  width: 1px;
  height: 1px;
}
.n5-skill-picker span {
  border: 1px solid #dfe7f2;
  background: #f8fafe;
  color: #6a7c97;
  border-radius: 7px;
  padding: 7px 10px;
  display: inline-block;
  font-size: 12px;
  transition: all 0.15s;
}
.n5-skill-picker input:checked + span {
  background: #eaf1ff;
  border-color: #82a7f4;
  color: #205ed3;
}
.n5-skill-picker input:checked + span:before {
  content: "✓ ";
  font-weight: 750;
}
.n5-skill-picker input:focus-visible + span {
  outline: 3px solid #a5c4ff;
  outline-offset: 2px;
}
.n5-skill-picker input:disabled + span {
  opacity: 0.7;
  cursor: not-allowed;
}
.n5-skill-picker small {
  font-size: 9px;
}
.n5-check {
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 13px;
  color: #6c7c93;
}
.n5-check input {
  accent-color: var(--n5-blue);
  width: 16px;
  height: 16px;
}
.n5-auth-wrap {
  display: grid;
  grid-template-columns: 1fr 1fr;
  max-width: 1010px;
  margin-top: 48px;
  margin-bottom: 50px;
  border: 1px solid var(--n5-border);
  border-radius: 20px;
  overflow: hidden;
  background: #fff;
}
.n5-auth-story {
  background: linear-gradient(140deg, #edf4ff, #dceaff);
  padding: 50px 40px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.n5-auth-story h1 {
  font-size: 39px;
  margin-bottom: 22px;
  line-height: 1.18;
  color: #204884;
}
.n5-auth-story > p {
  color: #6b87ae;
  font-size: 14px;
  max-width: 310px;
}
.n5-auth-story > small {
  color: #92a8c6;
  margin-top: auto;
  font-size: 10px;
  letter-spacing: 1px;
}
.n5-auth-visual {
  position: relative;
  height: 230px;
  margin-top: 20px;
}
.n5-auth-visual strong {
  font-size: 29px;
  line-height: 1.3;
  color: #7697c6;
  position: absolute;
  left: 24px;
  top: 70px;
  transform: rotate(-5deg);
  letter-spacing: -1px;
}
.n5-auth-visual > span {
  position: absolute;
  background: white;
  padding: 12px 18px;
  box-shadow: 0 7px 18px #3764a114;
  border-radius: 10px;
  color: #4f7fc0;
  font-weight: 700;
  font-size: 14px;
}
.n5-auth-visual > span:nth-child(1) {
  top: 5px;
  left: 0;
  transform: rotate(-12deg);
}
.n5-auth-visual > span:nth-child(2) {
  top: 25px;
  right: 0;
  transform: rotate(9deg);
}
.n5-auth-visual > span:nth-child(3) {
  bottom: 12px;
  right: 50px;
  transform: rotate(-3deg);
}
.n5-auth-form {
  padding: 45px 40px;
  align-self: center;
}
.n5-auth-form h2 {
  font-size: 28px;
}
.n5-auth-form > p {
  color: #8a97ab;
  font-size: 13px;
  margin: 12px 0 28px;
}
.n5-auth-form .form-label {
  font-size: 13px;
}
.n5-auth-form small {
  font-size: 11px;
  display: block;
  margin-top: 6px;
}
.n5-auth-form .n5-auth-switch {
  font-size: 12px;
  text-align: center;
  margin: 24px 0 0;
}
.n5-role-picker {
  display: flex;
  gap: 12px;
}
.n5-role-picker label {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px;
  border: 1px solid #dbe5f4;
  border-radius: 8px;
  flex: 1;
  font-size: 12px;
  white-space: nowrap;
  cursor: pointer;
}
.n5-role-picker label:has(input:checked) {
  border-color: #83a7ee;
  background: #edf3ff;
  color: #2865d1;
}
.n5-role-picker input {
  accent-color: var(--n5-blue);
}
.n5-table-wrap {
  background: white;
  border: 1px solid var(--n5-border);
  border-radius: 12px;
  overflow: auto;
}
.n5-table {
  margin: 0;
  vertical-align: middle;
  font-size: 13px;
  min-width: 640px;
}
.n5-table thead th {
  background: #f1f5fb;
  color: #7889a3;
  font-size: 11px;
  font-weight: 650;
  padding: 16px 20px;
  border-color: #e5ecf6;
  white-space: nowrap;
}
.n5-table td {
  padding: 19px 20px;
  border-color: #eef2f8;
  color: #62748f;
}
.n5-table td strong {
  color: #243d61;
  font-size: 13px;
}
.n5-table td small {
  display: block;
  font-size: 11px;
  margin-top: 5px;
  color: #8c9aaf;
}
.n5-table tr:last-child td {
  border: 0;
}
.n5-actions {
  display: flex;
  align-items: center;
  gap: 7px;
  flex-wrap: wrap;
}
.n5-status {
  display: inline-block;
  border-radius: 6px;
  background: #f0f3f8;
  color: #7a8ba4;
  padding: 5px 10px;
  font-size: 11px;
  font-weight: 650;
  white-space: nowrap;
}
.n5-status-Published,
.n5-status-Accepted {
  background: #eaf7f0;
  color: #258960;
}
.n5-status-Submitted {
  background: #edf3ff;
  color: #4377d6;
}
.n5-status-Reviewing {
  background: #fff5df;
  color: #a47f2c;
}
.n5-status-Rejected {
  background: #ffedf0;
  color: #c06679;
}
.n5-timeline {
  list-style: none;
  padding: 0;
  margin: 0 0 30px;
}
.n5-timeline li {
  position: relative;
  padding: 0 0 24px 31px;
  color: #a4afbe;
  font-size: 13px;
}
.n5-timeline li:before {
  content: "";
  position: absolute;
  left: 1px;
  top: 3px;
  width: 13px;
  height: 13px;
  background: #e3eaf4;
  border: 3px solid #f1f5fb;
  border-radius: 50%;
  z-index: 1;
}
.n5-timeline li:after {
  content: "";
  position: absolute;
  left: 7px;
  top: 16px;
  bottom: 0;
  width: 1px;
  background: #e0e8f3;
}
.n5-timeline li:last-child:after {
  display: none;
}
.n5-timeline li.done {
  color: #4377c7;
}
.n5-timeline li.done:before {
  background: var(--n5-blue);
  border-color: #dce9ff;
}
.n5-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
  margin-bottom: 27px;
}
.n5-stat {
  padding: 28px;
  border: 1px solid var(--n5-border);
  border-radius: 12px;
  background: #fff;
}
.n5-stat > span {
  color: #8191a9;
  font-size: 13px;
}
.n5-stat strong {
  display: block;
  font-size: 45px;
  line-height: 1.5;
  color: #264e86;
}
.n5-stat small {
  color: #92a0b5;
  font-size: 11px;
}
.n5-stat-blue {
  background: var(--n5-blue);
  border-color: var(--n5-blue);
}
.n5-stat-blue strong {
  color: white;
}
.n5-stat-blue > span {
  color: #d7e4ff;
}
.n5-stat-blue small {
  color: #b7d0ff;
}
.n5-dashboard-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 25px;
}
.n5-bar-row {
  margin-top: 24px;
}
.n5-bar-row > div:first-child {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: #6d809c;
  margin-bottom: 9px;
}
.n5-bar-row strong {
  font-size: 12px;
  color: #4a6489;
}
.n5-bar-track {
  height: 10px;
  border-radius: 8px;
  background: #eef3f9;
  overflow: hidden;
}
.n5-bar-track span {
  height: 100%;
  display: block;
  border-radius: 8px;
}
.n5-quick-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 23px 0;
  border-bottom: 1px solid #edf1f7;
  font-size: 20px;
}
.n5-quick-link:last-child {
  border: 0;
}
.n5-quick-link strong {
  display: block;
  font-size: 13px;
  color: #3e5c87;
}
.n5-quick-link small {
  display: block;
  color: #98a5b8;
  font-size: 11px;
  margin-top: 5px;
}
.n5-inline-empty {
  padding: 16px;
  border-radius: 8px;
  background: #f1f6fd;
}
.n5-dashboard-skeleton {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
.n5-dashboard-skeleton > div {
  height: 170px;
  background: linear-gradient(100deg, #e9eff7, #f6f9ff, #e9eff7);
  border-radius: 12px;
}
.n5-dashboard-skeleton p {
  grid-column: 1/-1;
  color: var(--n5-muted);
}
@media (min-width: 1500px) {
  .n5-hero-grid {
    min-height: 480px;
  }
  .n5-hero h1 {
    font-size: 49px;
  }
}
@media (max-width: 1199px) {
  .n5-container {
    width: calc(100% - 48px);
  }
  .navbar-nav {
    gap: 12px;
  }
  .n5-header .navbar {
    gap: 24px;
  }
  .n5-brand {
    font-size: 23px;
  }
  .n5-role {
    display: none;
  }
  .n5-hero-grid {
    grid-template-columns: 1.8fr 1fr;
  }
  .n5-hero h1 {
    font-size: 39px;
  }
  .n5-hero-art {
    transform: scale(0.85);
    transform-origin: left center;
  }
  .n5-content-grid {
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 20px;
  }
  .n5-job-card {
    padding: 18px;
    gap: 12px;
  }
  .n5-job-bottom {
    flex-wrap: wrap;
  }
  .n5-matching-skills {
    gap: 12px;
  }
  .n5-detail-link {
    margin-left: auto;
  }
  .n5-search-location {
    max-width: 175px;
  }
  .n5-job-meta {
    gap: 10px;
  }
}
@media (max-width: 991px) {
  .n5-header .navbar {
    min-height: 80px;
  }
  .navbar-collapse {
    padding: 18px 0 8px;
  }
  .navbar-nav {
    gap: 0;
  }
  .navbar-nav .nav-link.active:after {
    display: none;
  }
  .n5-account {
    padding-top: 12px;
  }
  .n5-hero-grid {
    grid-template-columns: 1fr;
    padding-top: 36px;
    padding-bottom: 32px;
    min-height: 0;
  }
  .n5-hero-art {
    display: none;
  }
  .n5-hero h1 {
    font-size: 42px;
  }
  .n5-hero-copy > p {
    font-size: 15px;
  }
  .n5-search {
    max-width: 720px;
  }
  .n5-content-grid {
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 17px;
  }
  .n5-job-card {
    padding: 18px 16px;
  }
  .n5-job-card .n5-company-icon {
    width: 40px;
    height: 43px;
    font-size: 23px;
  }
  .n5-open {
    display: none;
  }
  .n5-job-bottom {
    display: grid;
    grid-template-columns: 1fr;
    gap: 13px;
  }
  .n5-matching-skills {
    flex-wrap: wrap;
  }
  .n5-detail-link {
    margin-left: 0;
    width: fit-content;
  }
  .n5-profile-aside {
    padding: 21px 18px;
  }
  .n5-auth-wrap {
    grid-template-columns: 0.9fr 1fr;
  }
  .n5-auth-story {
    padding: 35px 25px;
  }
  .n5-auth-story h1 {
    font-size: 33px;
  }
  .n5-auth-form {
    padding: 35px 27px;
  }
  .n5-panel {
    padding: 24px;
  }
  .n5-role-picker {
    flex-direction: column;
    gap: 7px;
  }
  .n5-dashboard-grid {
    grid-template-columns: 1fr;
  }
  .n5-section-heading h1 {
    font-size: 30px;
  }
}
@media (max-width: 700px) {
  .n5-container {
    width: calc(100% - 32px);
  }
  .n5-header .navbar {
    min-height: 73px;
  }
  .n5-brand {
    font-size: 23px;
  }
  .n5-mark {
    width: 36px;
    height: 39px;
    line-height: 38px;
    font-size: 23px;
  }
  .n5-hero-grid {
    padding-top: 30px;
    padding-bottom: 28px;
  }
  .n5-eyebrow {
    font-size: 8px;
    letter-spacing: 1.2px;
  }
  .n5-hero h1 {
    font-size: 35px;
    letter-spacing: -1.4px;
  }
  .n5-hero-copy > p {
    font-size: 13px;
  }
  .n5-search {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 7px;
    padding: 9px;
  }
  .n5-search-keyword {
    grid-column: 1/-1;
    min-height: 40px;
    padding: 0 8px;
    border-bottom: 1px solid #e7edf5;
    padding-bottom: 7px;
  }
  .n5-search-location {
    max-width: none;
    border: 0;
    padding-left: 8px;
  }
  .n5-search .btn {
    padding: 10px 17px;
  }
  .n5-search-location select {
    font-size: 12px;
  }
  .n5-popular {
    font-size: 10px;
    gap: 6px;
  }
  .n5-popular a {
    font-size: 9px;
    padding: 4px 7px;
  }
  .n5-content-grid {
    grid-template-columns: 1fr;
  }
  .n5-profile-aside {
    margin-top: 7px;
  }
  .n5-section-heading {
    align-items: start;
    gap: 14px;
  }
  .n5-section-heading h1,
  .n5-section-heading h2 {
    font-size: 26px;
  }
  .n5-section-heading p {
    font-size: 12px;
  }
  .n5-section-heading .n5-eyebrow {
    font-size: 7px;
    letter-spacing: 1px;
  }
  .n5-section-heading > .n5-text-link {
    font-size: 11px;
    margin-top: 23px;
  }
  .n5-section-heading > .btn {
    font-size: 11px;
    padding: 9px 12px;
  }
  .n5-home-jobs {
    padding-top: 29px;
    padding-bottom: 30px;
  }
  .n5-job-card {
    padding: 17px 14px;
    gap: 12px;
  }
  .n5-job-top h3 {
    font-size: 16px;
  }
  .n5-job-bottom {
    display: flex;
    flex-wrap: wrap;
  }
  .n5-job-content .n5-company-name {
    font-size: 11px;
  }
  .n5-job-meta {
    font-size: 10px;
    gap: 6px 11px;
  }
  .n5-match {
    min-width: 130px;
  }
  .n5-matching-skills {
    min-width: 120px;
    gap: 10px;
  }
  .n5-job-card .n5-detail-link {
    font-size: 10px;
    margin-left: 0;
  }
  .n5-job-list {
    gap: 12px;
  }
  .n5-how {
    grid-template-columns: 1fr;
    gap: 22px;
    padding-top: 24px;
    padding-bottom: 28px;
  }
  .n5-how h3 {
    font-size: 14px;
  }
  .n5-how p {
    font-size: 12px;
  }
  .n5-footer {
    font-size: 10px;
    padding: 20px 0;
  }
  .n5-page {
    padding-top: 25px;
    padding-bottom: 36px;
  }
  .n5-page-banner {
    padding: 26px 0;
  }
  .n5-page-banner h1 {
    font-size: 28px;
  }
  .n5-page-banner p {
    font-size: 13px;
  }
  .n5-page-banner .n5-search {
    margin-top: 20px;
  }
  .n5-panel {
    padding: 22px;
  }
  .n5-panel h2 {
    font-size: 20px;
  }
  .n5-detail-header {
    padding: 23px 20px;
    align-items: start;
    gap: 15px;
  }
  .n5-detail-header h1 {
    font-size: 26px;
  }
  .n5-company-icon-lg {
    width: 48px;
    height: 52px;
    font-size: 30px;
  }
  .n5-detail-header .n5-job-meta {
    font-size: 11px;
  }
  .n5-apply-panel {
    position: static;
  }
  .n5-auth-wrap {
    display: block;
    margin-top: 25px;
    margin-bottom: 30px;
  }
  .n5-auth-story {
    padding: 25px;
  }
  .n5-auth-story h1 {
    font-size: 28px;
    margin-bottom: 10px;
  }
  .n5-auth-story > p {
    margin: 0;
    font-size: 12px;
    max-width: none;
  }
  .n5-auth-visual,
  .n5-auth-story > small {
    display: none;
  }
  .n5-auth-form {
    padding: 28px 24px;
  }
  .n5-auth-form h2 {
    font-size: 25px;
  }
  .n5-role-picker {
    flex-direction: row;
  }
  .n5-filter-row .form-select {
    max-width: 230px;
  }
  .n5-stats {
    gap: 12px;
    grid-template-columns: 1fr;
  }
  .n5-stat {
    padding: 21px;
    position: relative;
  }
  .n5-stat strong {
    position: absolute;
    right: 23px;
    top: 17px;
    font-size: 35px;
    line-height: 1.4;
  }
  .n5-stat small {
    display: block;
    max-width: 220px;
    padding-top: 7px;
  }
  .n5-dashboard-skeleton {
    grid-template-columns: 1fr;
  }
  .n5-dashboard-skeleton > div {
    height: 100px;
  }
  .n5-empty {
    padding: 35px 20px;
  }
  .n5-empty h2,
  .n5-empty h3 {
    font-size: 21px;
  }
  .n5-pagination a {
    width: 34px;
    height: 34px;
  }
}
@media (prefers-reduced-motion: reduce) {
  * {
    scroll-behavior: auto !important;
    transition: none !important;
    animation: none !important;
  }
}
.n5-brand .n5-mark > span {
  color: #c8d9ff;
}

/* Kích thước tối thiểu cho thông tin ứng viên đọc thường xuyên. */
.n5-job-meta, .n5-company-name { font-size: 12px; }
.n5-chip, .n5-matching-skills .n5-chip { font-size: 11px; }
.n5-matching-skills > div > small, .n5-match > div > small { font-size: 11px; }
.n5-match strong { font-size: 12px; }
.n5-match-ring { width: 55px; height: 55px; }
.n5-match-ring > span { font-size: 12px; }
.n5-detail-link { font-size: 12px; }
.n5-note, .n5-profile-aside p { font-size: 12px; }
@media (min-width:701px) and (max-width:991px) {
  .n5-content-grid { grid-template-columns: 1fr; }
  .n5-job-bottom { display: flex; flex-wrap: wrap; }
  .n5-detail-link { margin-left: auto; }
}
@media (max-width:700px) {
  .n5-job-meta, .n5-job-content .n5-company-name { font-size: 11px; }
  .n5-job-card .n5-detail-link { font-size: 11px; }
  .n5-matching-skills { flex-basis: 100%; }
  .n5-section-heading { flex-wrap: wrap; }
  .n5-section-heading > .n5-text-link { margin-top: 0; }
}
