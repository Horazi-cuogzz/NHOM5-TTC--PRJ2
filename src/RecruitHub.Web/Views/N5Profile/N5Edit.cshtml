@model N5ProfileViewModel
@{ ViewData["Title"] = "Hồ sơ của tôi"; }
<div class="n5-container n5-page">
<div class="n5-section-heading"><div><div class="n5-eyebrow">HỒ SƠ ỨNG VIÊN</div><h1>Thể hiện thế mạnh của bạn.</h1><p>Thông tin và kỹ năng giúp bạn tìm đúng cơ hội.</p></div><a class="n5-text-link" asp-controller="N5Jobs" asp-action="Recommended">Xem việc làm phù hợp →</a></div>
<form method="post" asp-action="Edit" class="n5-content-grid">
<section class="n5-panel"><h2>Thông tin cá nhân</h2><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row g-3">
<div class="col-md-6"><label asp-for="FullName" class="form-label">Họ và tên <span class="text-danger">*</span></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName"></span></div>
<div class="col-md-6"><label asp-for="Email" class="form-label">Email tài khoản</label><input asp-for="Email" class="form-control" readonly /></div>
<div class="col-md-6"><label asp-for="Phone" class="form-label">Số điện thoại <span class="text-danger">*</span></label><input asp-for="Phone" class="form-control" /><span asp-validation-for="Phone"></span></div>
<div class="col-md-6"><label asp-for="Location" class="form-label">Địa điểm</label><input asp-for="Location" class="form-control" placeholder="Ví dụ: Hà Nội" /><span asp-validation-for="Location"></span></div>
<div class="col-12"><label asp-for="Introduction" class="form-label">Giới thiệu bản thân <span class="text-danger">*</span></label><textarea asp-for="Introduction" class="form-control" rows="4" placeholder="Lĩnh vực bạn quan tâm và thế mạnh của bạn..."></textarea><span asp-validation-for="Introduction"></span></div>
<div class="col-12"><label asp-for="Education" class="form-label">Học vấn</label><textarea asp-for="Education" class="form-control" rows="3"></textarea><span asp-validation-for="Education"></span></div>
<div class="col-12"><label asp-for="Experience" class="form-label">Kinh nghiệm và dự án</label><textarea asp-for="Experience" class="form-control" rows="4"></textarea><span asp-validation-for="Experience"></span></div>
</div><button class="btn btn-primary mt-4" type="submit">Lưu hồ sơ →</button>
</section>
<aside class="n5-panel"><h2>Kỹ năng của bạn</h2><p class="text-muted">Chọn ít nhất một kỹ năng. Đây là cơ sở để tính tỷ lệ phù hợp với từng tin.</p>
<div class="n5-skill-picker">@foreach (var s in Model.SkillOptions) { <label><input type="checkbox" name="SkillIds" value="@s.Id" checked="@Model.SkillIds.Contains(s.Id)" /><span>@s.Name @if (!s.IsActive) { <small>(ngừng dùng)</small> }</span></label> }</div><span asp-validation-for="SkillIds"></span>
<div class="n5-note">Hồ sơ chỉ được nhà tuyển dụng xem khi bạn ứng tuyển vào tin của công ty đó.</div></aside>
</form></div>

