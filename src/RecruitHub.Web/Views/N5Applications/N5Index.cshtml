@model N5ApplicationListViewModel
@{ ViewData["Title"] = Model.IsEmployer ? "Hồ sơ ứng tuyển" : "Đơn đã gửi"; }
<div class="n5-container n5-page"><div class="n5-section-heading"><div><div class="n5-eyebrow">@(Model.IsEmployer ? "KẾT NỐI ỨNG VIÊN" : "HÀNH TRÌNH ỨNG TUYỂN")</div><h1>@ViewData["Title"]</h1><p>@Model.Total đơn · @(Model.IsEmployer ? "Theo dõi và xử lý hồ sơ của công ty." : "Cập nhật phản hồi từ nhà tuyển dụng.")</p></div></div>
<form method="get" asp-action="Index" class="n5-filter-row justify-content-start">
@if (Model.IsEmployer) { <label class="visually-hidden" for="n5-job-filter">Tin tuyển dụng</label><select id="n5-job-filter" name="jobId" class="form-select w-auto"><option value="">Tất cả tin</option>@foreach (var j in Model.Jobs) { <option value="@j.Id" selected="@(Model.JobId == j.Id)">@j.Title</option> }</select> }
<label class="visually-hidden" for="n5-status-filter">Trạng thái</label><select id="n5-status-filter" name="status" class="form-select w-auto"><option value="">Tất cả trạng thái</option>@foreach (var s in Enum.GetValues<N5ApplicationStatus>()) { <option value="@s" selected="@(Model.Status == s)">@N5Display.ApplicationStatus(s)</option> }</select><button class="btn btn-outline-primary">Lọc đơn</button>
</form>
@if (Model.Applications.Count == 0) { <div class="n5-empty"><span>◇</span><h2>Chưa có đơn để hiển thị</h2><p>@(Model.IsEmployer ? "Đơn mới sẽ xuất hiện khi ứng viên gửi hồ sơ vào tin của công ty." : "Khám phá việc làm và gửi hồ sơ để bắt đầu.")</p>@if (!Model.IsEmployer) { <a class="btn btn-primary" asp-controller="N5Jobs" asp-action="Index">Tìm việc ngay</a> }</div> }
else
{
<div class="n5-table-wrap"><table class="table n5-table"><thead><tr><th>@(Model.IsEmployer ? "Ứng viên" : "Công việc")</th><th>@(Model.IsEmployer ? "Vị trí ứng tuyển" : "Công ty")</th><th>Ngày gửi</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach (var a in Model.Applications)
{
<tr><td><strong>@(Model.IsEmployer ? a.CandidateProfile.User.FullName : a.JobPosting.Title)</strong>@if (Model.IsEmployer) { <small>@a.CandidateProfile.User.Email</small> }</td><td>@(Model.IsEmployer ? a.JobPosting.Title : a.JobPosting.Company.Name)</td><td>@N5Display.Date(a.AppliedAt)</td><td><span class="n5-status n5-status-@a.Status">@N5Display.ApplicationStatus(a.Status)</span></td><td><a class="n5-text-link" asp-action="Details" asp-route-id="@a.Id">Chi tiết ↗</a></td></tr>
}
</tbody></table></div>
}
@if (Model.Pages > 1) { <nav class="n5-pagination" aria-label="Phân trang">@for (var i = 1; i <= Model.Pages; i++) { <a asp-action="Index" asp-route-page="@i" asp-route-jobId="@Model.JobId" asp-route-status="@Model.Status" class="@(i == Model.Page ? "active" : "")">@i</a> }</nav> }
</div>

