@model N5JobDetailsViewModel
@{ ViewData["Title"] = Model.Job.Title; }
<div class="n5-container n5-page">
<a class="n5-back" asp-action="Index">← Danh sách việc làm</a>
<div class="n5-detail-header"><div class="n5-company-icon n5-company-icon-lg">@Model.Job.Company.Name.FirstOrDefault()</div><div><span class="n5-eyebrow">@N5Display.JobStatus(Model.Job)</span><h1>@Model.Job.Title</h1><p>@Model.Job.Company.Name</p><div class="n5-job-meta"><span>@(string.IsNullOrWhiteSpace(Model.Job.Location) ? "Chưa cập nhật" : Model.Job.Location)</span><span class="n5-salary">@(string.IsNullOrWhiteSpace(Model.Job.SalaryText) ? "Thỏa thuận" : Model.Job.SalaryText)</span><span>Hạn @N5Display.Date(Model.Job.Deadline)</span></div></div></div>
<div class="n5-content-grid">
<div><section class="n5-panel"><h2>Mô tả công việc</h2><div class="n5-prose">@Model.Job.Description</div><h3 class="mt-4">Kỹ năng yêu cầu</h3><div class="n5-chips">@foreach (var skill in Model.Card.RequiredSkills) { <span class="n5-chip">@skill.Name</span> }</div></section>
<section class="n5-panel mt-4"><h2>Về @Model.Job.Company.Name</h2><div class="n5-prose">@(string.IsNullOrWhiteSpace(Model.Job.Company.Description) ? "Chưa cập nhật thông tin giới thiệu công ty." : Model.Job.Company.Description)</div>@if (!string.IsNullOrWhiteSpace(Model.Job.Company.Address)) { <p class="mt-3 text-muted">@Model.Job.Company.Address</p> }@if (Uri.TryCreate(Model.Job.Company.Website, UriKind.Absolute, out var website) && website.Scheme is "https" or "http") { <a href="@website" rel="noopener noreferrer" target="_blank">Website công ty ↗</a> }</section></div>
<aside class="n5-panel n5-apply-panel">
@if (Model.Card.ScorePercent.HasValue)
{
    <div class="n5-big-score">@Model.Card.ScorePercent.Value.ToString("0.##", CultureInfo.GetCultureInfo("vi-VN"))<span>%</span></div><h3>Phù hợp kỹ năng</h3><p>@Model.Card.MatchedCount/@Model.Card.RequiredCount kỹ năng yêu cầu</p>
    <small>Đã đáp ứng</small><div class="n5-chips my-2">@foreach (var s in Model.Card.MatchedSkills) { <span class="n5-chip n5-chip-green">✓ @s.Name</span> }</div>
    <small>Còn thiếu</small><div class="n5-chips my-2">@foreach (var s in Model.Card.MissingSkills) { <span class="n5-chip n5-chip-muted">@s.Name</span> }@if (Model.Card.MissingSkills.Count == 0) { <span class="text-success">Bạn đã đáp ứng đủ kỹ năng.</span> }</div><hr />
}
@if (Model.ExistingApplicationId.HasValue)
{
    <h3>Bạn đã ứng tuyển</h3><p>Theo dõi phản hồi từ nhà tuyển dụng trong đơn của bạn.</p><a class="btn btn-primary w-100" asp-controller="N5Applications" asp-action="Details" asp-route-id="@Model.ExistingApplicationId">Xem đơn đã gửi</a>
}
else if (Model.CanApply)
{
    <h3>Gửi lời giới thiệu</h3><form method="post" asp-action="Apply" asp-route-id="@Model.Job.Id"><label class="form-label" for="n5-letter">Thư giới thiệu <span class="text-muted">(không bắt buộc)</span></label><textarea id="n5-letter" name="coverLetter" class="form-control" rows="5" maxlength="2000" placeholder="Vì sao bạn quan tâm đến vị trí này?"></textarea><small class="d-block text-muted my-3">Nhà tuyển dụng sẽ xem hồ sơ hiện tại của bạn. Hãy bảo đảm thông tin đã đầy đủ.</small><button class="btn btn-primary w-100" type="submit">Xác nhận gửi ứng tuyển <span class="n5-btn-arrow" aria-hidden="true">→</span></button></form><a class="n5-text-link d-block text-center mt-3" asp-controller="N5Profile" asp-action="Edit">Xem lại hồ sơ</a>
}
else if (User.Identity?.IsAuthenticated != true)
{
    <h3>Sẵn sàng cho cơ hội mới?</h3><p>Đăng nhập tài khoản ứng viên để gửi hồ sơ của bạn.</p><a class="btn btn-primary w-100" asp-controller="N5Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Đăng nhập để ứng tuyển</a>
}
else { <p>Ứng tuyển dành cho tài khoản ứng viên khi tin còn nhận hồ sơ.</p> }
</aside></div>
</div>

