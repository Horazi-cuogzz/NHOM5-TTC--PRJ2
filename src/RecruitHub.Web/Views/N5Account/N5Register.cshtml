@model N5RegisterViewModel
@{ ViewData["Title"] = "Tạo tài khoản"; }
<div class="n5-auth-wrap n5-container">
<section class="n5-auth-story"><div class="n5-eyebrow">CÙNG RECRUITHUB</div><h1>Kết nối kỹ năng.<br />Mở lối tương lai.</h1><p>Tạo hồ sơ để tìm cơ hội phù hợp, hoặc kết nối với những ứng viên cho doanh nghiệp của bạn.</p><div class="n5-auth-visual"><span>C#</span><span>HTML</span><span>Git</span><strong>Mỗi kỹ năng<br />là một khởi đầu.</strong></div></section>
<section class="n5-auth-form"><h2>Tạo tài khoản</h2><p>Bắt đầu với vai trò phù hợp với bạn.</p><form method="post" asp-action="Register"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<div class="n5-role-picker mb-3"><label><input type="radio" asp-for="Role" value="Candidate" /> Ứng viên</label><label><input type="radio" asp-for="Role" value="Employer" /> Nhà tuyển dụng</label></div><span asp-validation-for="Role"></span>
<div class="mb-3"><label asp-for="FullName" class="form-label">Họ và tên</label><input asp-for="FullName" class="form-control" autocomplete="name" /><span asp-validation-for="FullName"></span></div>
<div class="mb-3"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email"></span></div>
<div class="mb-3"><label asp-for="Password" class="form-label">Mật khẩu</label><input asp-for="Password" class="form-control" autocomplete="new-password" /><small class="text-muted">Ít nhất 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</small><span asp-validation-for="Password"></span></div>
<div class="mb-4"><label asp-for="ConfirmPassword" class="form-label">Nhập lại mật khẩu</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div>
<button class="btn btn-primary w-100">Tạo tài khoản <span class="n5-btn-arrow" aria-hidden="true">→</span></button></form><p class="n5-auth-switch">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p></section>
</div>

