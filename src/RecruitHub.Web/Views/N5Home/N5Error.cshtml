@{ ViewData["Title"] = "Thông báo"; var code = (int?)ViewBag.StatusCode ?? 500; }
<div class="n5-container n5-empty n5-page"><span>@code</span><h1>@(code == 404 ? "Không tìm thấy nội dung" : code == 403 ? "Bạn chưa có quyền truy cập" : "Chưa thể hoàn tất yêu cầu")</h1><p>Vui lòng quay lại trang chủ hoặc thử lại sau.</p><a class="btn btn-primary" asp-controller="N5Home" asp-action="Index">Về trang chủ</a></div>

