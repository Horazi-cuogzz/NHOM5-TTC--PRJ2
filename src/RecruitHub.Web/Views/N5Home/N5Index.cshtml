@model N5JobListViewModel
@{ ViewData["Title"] = "Cơ hội IT dành cho bạn"; }
<section class="n5-hero">
<div class="n5-container n5-hero-grid">
    <div class="n5-hero-copy">
        <div class="n5-eyebrow"><span></span> KẾT NỐI NHÂN TÀI CÔNG NGHỆ</div>
        <h1>Công việc phù hợp với<br /><em>kỹ năng của bạn.</em></h1>
        <p>Khám phá cơ hội IT và biết bạn phù hợp ở đâu.<br class="d-none d-sm-block" /> Một bước gần hơn đến công việc tiếp theo.</p>
        <partial name="N5Search" model="Model" />
        <div class="n5-popular"><span>Kỹ năng phổ biến:</span>@foreach (var name in new[] { "C#", "React", "SQL Server" }) { <a asp-controller="N5Jobs" asp-action="Index" asp-route-query="@name">@name <span aria-hidden="true">↗</span></a> }</div>
    </div>
    <div class="n5-hero-art" aria-hidden="true">
        <div class="n5-orbit n5-orbit-one"></div><div class="n5-orbit n5-orbit-two"></div>
        <div class="n5-art-browser"><div class="n5-browser-bar"><i></i><i></i><i></i><span>recruithub / cơ hội của bạn</span></div><div class="n5-art-heading"><span class="n5-art-logo">rh</span><div><b>Lập trình viên .NET</b><small>Cơ hội mới dành cho bạn</small></div></div><div class="n5-art-lines"><i></i><i></i><i></i></div><div class="n5-art-tags"><span>C#</span><span>SQL Server</span><span>Git</span></div><div class="n5-art-check">✓ <span>Kết nối đúng kỹ năng</span><b>↗</b></div></div>
        <div class="n5-floating n5-floating-csharp">C#</div><div class="n5-floating n5-floating-react">React<span>✧</span></div>
        <div class="n5-floating-profile"><div class="n5-art-avatar">⌘</div><div><strong>Hồ sơ của bạn</strong><small>Sẵn sàng cho cơ hội mới</small></div><span>✓</span></div>
        <div class="n5-art-caption">KỸ NĂNG CỦA BẠN. CƠ HỘI CỦA BẠN.</div>
    </div>
</div>
</section>
<section class="n5-container n5-home-jobs">
    <div class="n5-section-heading"><div><div class="n5-eyebrow">BƯỚC TIẾP THEO TRONG SỰ NGHIỆP</div><h2>@(Model.IsRecommendation ? "Việc làm phù hợp" : "Khám phá việc làm IT")</h2><p>@(Model.IsRecommendation ? "Dựa trên kỹ năng trong hồ sơ của bạn" : "Những cơ hội đang mở, sẵn sàng để bạn khám phá.")</p></div><a class="n5-text-link" asp-controller="N5Jobs" asp-action="@(Model.IsRecommendation ? "Recommended" : "Index")">Xem tất cả <span aria-hidden="true">→</span></a></div>
    <div class="n5-content-grid"><div class="n5-job-list">
    @foreach (var job in Model.Jobs) { <partial name="N5JobCard" model="job" /> }
    @if (Model.Jobs.Count == 0) { <div class="n5-empty"><span>⌕</span><h3>Chưa có việc làm phù hợp</h3><p>Bổ sung kỹ năng trong hồ sơ hoặc khám phá thêm các tin đang tuyển.</p><a class="btn btn-primary" asp-controller="N5Jobs" asp-action="Index">Khám phá việc làm</a></div> }
    </div><partial name="N5ProfileAside" model="Model" /></div>
</section>
<section class="n5-container n5-how"><div><span>01</span><h3>Hoàn thiện hồ sơ</h3><p>Giới thiệu bản thân và chọn kỹ năng bạn có.</p></div><div><span>02</span><h3>Tìm đúng cơ hội</h3><p>Xem công việc phù hợp và kỹ năng cần bổ sung.</p></div><div><span>03</span><h3>Kết nối doanh nghiệp</h3><p>Gửi đơn và theo dõi trạng thái ngay trên RecruitHub.</p></div></section>

