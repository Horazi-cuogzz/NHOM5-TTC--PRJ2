@model N5JobListViewModel
@{ ViewData["Title"] = "Cơ hội IT dành cho bạn"; }
<section class="n5-hero">
<div class="n5-container n5-hero-grid">
    <div class="n5-hero-copy">
        <div class="n5-eyebrow"><span></span> KẾT NỐI NHÂN TÀI CÔNG NGHỆ</div>
        <h1>Công việc phù hợp với<br /><em class="n5-wave-text">kỹ năng của bạn.</em></h1>
        <p>Khám phá cơ hội IT và biết bạn phù hợp ở đâu.<br class="d-none d-sm-block" /> Một bước gần hơn đến công việc tiếp theo.</p>
        <partial name="N5Search" model="Model" />
        <div class="n5-popular"><span>Kỹ năng phổ biến:</span>@foreach (var name in new[] { "C#", "React", "SQL Server" }) { <a asp-controller="N5Jobs" asp-action="Index" asp-route-query="@name">@name <span aria-hidden="true">↗</span></a> }</div>
    </div>
    <div class="n5-hero-art cdg-wrapper" id="n5-hero-deck" aria-hidden="true">
        <!-- Ambient drifting glow orbs -->
        <div class="cdg-orb cdg-orb-1"></div>
        <div class="cdg-orb cdg-orb-2"></div>
        <div class="cdg-orb cdg-orb-3"></div>

        <!-- Dot particle grid -->
        <div class="cdg-grid"></div>

        <!-- 3D Perspective Scene -->
        <div class="cdg-scene">
            <!-- Card 1: Frontend Developer -->
            <div class="cdg-card float-a" data-card="1" data-query="React" title="Xem việc làm React" style="--tx: -195px; --ty: 42px; --tz: -190px; --rx: 11deg; --ry: -17deg; --rz: -7deg; --sc: 0.85; --glow: rgba(14,165,233,0.5); --accent: #0ea5e9; animation-delay: 0s; z-index: 1;">
                <div class="cdg-card__glass"></div>
                <div class="cdg-card__glow-ring"></div>
                <div class="cdg-card__shine"></div>
                <div class="cdg-card__content">
                    <div class="cdg-card__badge" style="background: rgba(14,165,233,0.12); color: #0284c7;">Frontend</div>
                    <div class="cdg-card__role">React Engineer</div>
                    <div class="cdg-card__meta"><span>📍 TP. Hồ Chí Minh</span><span class="cdg-card__salary">18–30 tr</span></div>
                    <div class="cdg-card__chips"><span>React</span><span>TypeScript</span><span>JavaScript</span></div>
                </div>
                <div class="cdg-card__label">
                    <div class="cdg-card__dot" style="background:#0ea5e9; box-shadow:0 0 8px #0ea5e9;"></div>
                    <div><p class="cdg-card__name">React UI/UX</p><p class="cdg-card__sub">Modern Web Frontend</p></div>
                </div>
                <div class="cdg-card__corner-tl" style="border-color:#0ea5e9;"></div>
                <div class="cdg-card__corner-br" style="border-color:#0ea5e9;"></div>
            </div>

            <!-- Card 2: Cloud & Docker -->
            <div class="cdg-card float-b" data-card="2" data-query="Docker" title="Xem việc làm Docker / Cloud" style="--tx: 175px; --ty: -65px; --tz: -155px; --rx: -9deg; --ry: 15deg; --rz: 5deg; --sc: 0.87; --glow: rgba(245,158,11,0.5); --accent: #f59e0b; animation-delay: 0.8s; z-index: 2;">
                <div class="cdg-card__glass"></div>
                <div class="cdg-card__glow-ring"></div>
                <div class="cdg-card__shine"></div>
                <div class="cdg-card__content">
                    <div class="cdg-card__badge" style="background: rgba(245,158,11,0.12); color: #d97706;">Cloud</div>
                    <div class="cdg-card__role">DevOps &amp; Docker</div>
                    <div class="cdg-card__meta"><span>📍 Làm việc từ xa</span><span class="cdg-card__salary">22–35 tr</span></div>
                    <div class="cdg-card__chips"><span>Docker</span><span>Git</span><span>CI/CD</span></div>
                </div>
                <div class="cdg-card__label">
                    <div class="cdg-card__dot" style="background:#f59e0b; box-shadow:0 0 8px #f59e0b;"></div>
                    <div><p class="cdg-card__name">Cloud &amp; Docker</p><p class="cdg-card__sub">Container &amp; Automation</p></div>
                </div>
                <div class="cdg-card__corner-tl" style="border-color:#f59e0b;"></div>
                <div class="cdg-card__corner-br" style="border-color:#f59e0b;"></div>
            </div>

            <!-- Card 3: Python & Backend -->
            <div class="cdg-card float-c" data-card="3" data-query="Python" title="Xem việc làm Python" style="--tx: -105px; --ty: -75px; --tz: -115px; --rx: 7deg; --ry: -9deg; --rz: -4deg; --sc: 0.90; --glow: rgba(139,92,246,0.5); --accent: #8b5cf6; animation-delay: 1.4s; z-index: 3;">
                <div class="cdg-card__glass"></div>
                <div class="cdg-card__glow-ring"></div>
                <div class="cdg-card__shine"></div>
                <div class="cdg-card__content">
                    <div class="cdg-card__badge" style="background: rgba(139,92,246,0.12); color: #7c3aed;">Python</div>
                    <div class="cdg-card__role">Python Developer</div>
                    <div class="cdg-card__meta"><span>📍 Hà Nội</span><span class="cdg-card__salary">20–35 tr</span></div>
                    <div class="cdg-card__chips"><span>Python</span><span>Django</span><span>Docker</span></div>
                </div>
                <div class="cdg-card__label">
                    <div class="cdg-card__dot" style="background:#8b5cf6; box-shadow:0 0 8px #8b5cf6;"></div>
                    <div><p class="cdg-card__name">Python &amp; Data</p><p class="cdg-card__sub">Django &amp; Automation</p></div>
                </div>
                <div class="cdg-card__corner-tl" style="border-color:#8b5cf6;"></div>
                <div class="cdg-card__corner-br" style="border-color:#8b5cf6;"></div>
            </div>

            <!-- Card 4: Java Enterprise -->
            <div class="cdg-card float-a" data-card="4" data-query="Java" title="Xem việc làm Java" style="--tx: 135px; --ty: 58px; --tz: -80px; --rx: -5deg; --ry: 11deg; --rz: 3deg; --sc: 0.93; --glow: rgba(16,185,129,0.5); --accent: #10b981; animation-delay: 2s; z-index: 4;">
                <div class="cdg-card__glass"></div>
                <div class="cdg-card__glow-ring"></div>
                <div class="cdg-card__shine"></div>
                <div class="cdg-card__content">
                    <div class="cdg-card__badge" style="background: rgba(16,185,129,0.12); color: #059669;">Java</div>
                    <div class="cdg-card__role">Java Spring Boot</div>
                    <div class="cdg-card__meta"><span>📍 Đà Nẵng</span><span class="cdg-card__salary">16–26 tr</span></div>
                    <div class="cdg-card__chips"><span>Java</span><span>Spring Boot</span><span>MySQL</span></div>
                </div>
                <div class="cdg-card__label">
                    <div class="cdg-card__dot" style="background:#10b981; box-shadow:0 0 8px #10b981;"></div>
                    <div><p class="cdg-card__name">Java Enterprise</p><p class="cdg-card__sub">Spring Boot Services</p></div>
                </div>
                <div class="cdg-card__corner-tl" style="border-color:#10b981;"></div>
                <div class="cdg-card__corner-br" style="border-color:#10b981;"></div>
            </div>

            <!-- Card 5: Backend .NET Core -->
            <div class="cdg-card float-b" data-card="5" data-query="ASP.NET Core" title="Xem việc làm ASP.NET Core" style="--tx: -55px; --ty: 34px; --tz: -45px; --rx: 4deg; --ry: -7deg; --rz: -2deg; --sc: 0.96; --glow: rgba(37,99,235,0.5); --accent: #2563eb; animation-delay: 0.4s; z-index: 5;">
                <div class="cdg-card__glass"></div>
                <div class="cdg-card__glow-ring"></div>
                <div class="cdg-card__shine"></div>
                <div class="cdg-card__content">
                    <div class="cdg-card__badge" style="background: rgba(37,99,235,0.12); color: #1d4ed8;">Backend</div>
                    <div class="cdg-card__role">.NET Core Architect</div>
                    <div class="cdg-card__meta"><span>📍 Hà Nội</span><span class="cdg-card__salary">18–28 tr</span></div>
                    <div class="cdg-card__chips"><span>C#</span><span>ASP.NET Core</span><span>SQL Server</span></div>
                </div>
                <div class="cdg-card__label">
                    <div class="cdg-card__dot" style="background:#2563eb; box-shadow:0 0 8px #2563eb;"></div>
                    <div><p class="cdg-card__name">Backend .NET</p><p class="cdg-card__sub">Enterprise Cloud Services</p></div>
                </div>
                <div class="cdg-card__corner-tl" style="border-color:#2563eb;"></div>
                <div class="cdg-card__corner-br" style="border-color:#2563eb;"></div>
            </div>

            <!-- Card 6: HERO CARD (Front & Center - RecruitHub Verified Match) -->
            <div class="cdg-card cdg-card--hero float-hero" data-card="6" data-query=".NET" title="Xem việc làm Lập trình viên .NET phù hợp nhất" style="--tx: 10px; --ty: -12px; --tz: 70px; --rx: 0deg; --ry: 0deg; --rz: 0deg; --sc: 0.94; --glow: rgba(37,99,235,0.65); --accent: #2563eb; animation-delay: 0s; z-index: 10;">
                <div class="cdg-card__glass"></div>
                <div class="cdg-card__glow-ring"></div>
                <div class="cdg-card__shine"></div>
                <div class="cdg-card__content cdg-card__content--hero">
                    <div class="cdg-hero-top">
                        <span class="cdg-hero-logo">rh</span>
                        <div class="cdg-hero-titles">
                            <b>Lập trình viên .NET</b>
                            <small>Cơ hội tốt nhất cho bạn</small>
                        </div>
                        <span class="cdg-hero-match">98%<small>phù hợp</small></span>
                    </div>
                    <div class="cdg-hero-meta">
                        <span>⌾ Hà Nội · Hybrid</span>
                        <span class="cdg-hero-salary">25–40 triệu</span>
                    </div>
                    <div class="cdg-hero-tags">
                        <span class="is-match">✓ C#</span>
                        <span class="is-match">✓ SQL Server</span>
                        <span class="is-match">✓ Git</span>
                        <span>Azure</span>
                    </div>
                    <div class="cdg-hero-check">
                        <span class="cdg-check-icon">✓</span>
                        <span>Kết nối đúng kỹ năng</span>
                        <span class="cdg-arrow">↗</span>
                    </div>
                </div>
                <div class="cdg-card__label">
                    <div class="cdg-card__dot" style="background:#2563eb; box-shadow:0 0 8px #2563eb;"></div>
                    <div><p class="cdg-card__name">Hồ sơ ứng viên</p><p class="cdg-card__sub">Sẵn sàng cho cơ hội mới</p></div>
                </div>
                <div class="cdg-card__corner-tl" style="border-color:#2563eb;"></div>
                <div class="cdg-card__corner-br" style="border-color:#2563eb;"></div>
            </div>
        </div>

        <!-- Bottom caption text matching old project -->
        <div class="cdg-bottom-text">
            <span class="cdg-bottom-line"></span>
            <p>KỸ NĂNG CỦA BẠN · CƠ HỘI CỦA BẠN · RECRUITHUB</p>
            <span class="cdg-bottom-line"></span>
        </div>
    </div>
</div>
</section>
<section class="n5-container n5-home-jobs">
    @{
        var showRecommendedButton = !User.IsInRole("Employer") && !User.IsInRole("Admin");
    }
    <div class="n5-section-heading">
        <div>
            <div class="n5-eyebrow">BƯỚC TIẾP THEO TRONG SỰ NGHIỆP</div>
            <h2>@(Model.IsRecommendation ? "Việc làm phù hợp" : "Khám phá việc làm IT")</h2>
            <p>@(Model.IsRecommendation ? "Dựa trên kỹ năng trong hồ sơ của bạn" : "Những cơ hội đang mở, sẵn sàng để bạn khám phá.")</p>
        </div>
        <div class="n5-heading-actions">
            <a class="btn btn-outline-primary" asp-controller="N5Jobs" asp-action="Index">Xem tất cả <span class="n5-btn-arrow" aria-hidden="true">→</span></a>
            @if (showRecommendedButton)
            {
                <a class="btn btn-primary" asp-controller="N5Jobs" asp-action="Recommended">Việc làm phù hợp <span class="n5-btn-arrow" aria-hidden="true">→</span></a>
            }
        </div>
    </div>
    <div class="n5-content-grid"><div class="n5-job-list">
    @foreach (var job in Model.Jobs) { <partial name="N5JobCard" model="job" /> }
    @if (Model.Jobs.Count == 0)
    {
        <div class="n5-empty">
            <span>⌕</span>
            <h3>@(Model.IsRecommendation ? "Chưa có việc làm phù hợp mới" : "Hiện chưa có việc làm đang mở")</h3>
            <p>@(Model.IsRecommendation ? "Bổ sung kỹ năng trong hồ sơ hoặc xem tất cả các tin đang tuyển dụng." : "Các vị trí tuyển dụng mới sẽ sớm được cập nhật tại RecruitHub.")</p>
            <div class="d-flex flex-wrap justify-content-center gap-2">
                @if (Model.IsRecommendation)
                {
                    <a class="btn btn-outline-primary" asp-controller="N5Profile" asp-action="Edit">Cập nhật hồ sơ <span class="n5-btn-arrow" aria-hidden="true">↗</span></a>
                }
                <a class="btn btn-primary" asp-controller="N5Jobs" asp-action="Index">Xem tất cả việc làm <span class="n5-btn-arrow" aria-hidden="true">→</span></a>
            </div>
        </div>
    }
    </div><partial name="N5ProfileAside" model="Model" /></div>
</section>
<section class="n5-container n5-how"><div><span>01</span><h3>Hoàn thiện hồ sơ</h3><p>Giới thiệu bản thân và chọn kỹ năng bạn có.</p></div><div><span>02</span><h3>Tìm đúng cơ hội</h3><p>Xem công việc phù hợp và kỹ năng cần bổ sung.</p></div><div><span>03</span><h3>Kết nối doanh nghiệp</h3><p>Gửi đơn và theo dõi trạng thái ngay trên RecruitHub.</p></div></section>

