@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var candidate = User.IsInRole("Candidate");
    var employer = User.IsInRole("Employer");
    var admin = User.IsInRole("Admin");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="RecruitHub — Cổng tuyển dụng IT và gợi ý việc làm theo kỹ năng." />
    <meta name="view-transition" content="same-origin" />
    <title>@ViewData["Title"] · RecruitHub</title>
    <link rel="icon" href="~/n5-favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/lib/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/n5-site.css" asp-append-version="true" />
</head>
<body>
<a class="n5-skip" href="#main">Đến nội dung chính</a>
<header class="n5-header">
<nav class="navbar navbar-expand-lg n5-container" aria-label="Điều hướng chính">
    <a class="n5-brand" asp-controller="N5Home" asp-action="Index"><span class="n5-mark">r<span>h</span></span><span>Recruit<span>Hub</span><small>IT CAREERS · NHÓM 5</small></span></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#n5-menu" aria-controls="n5-menu" aria-expanded="false" aria-label="Mở menu"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="n5-menu">
        <div class="navbar-nav mx-lg-auto">
            <a class="nav-link @((controller is "N5Jobs" or "N5Home") && action != "Recommended" ? "active" : "")" asp-controller="N5Jobs" asp-action="Index">Tìm việc</a>
            @if (candidate)
            {
                <a class="nav-link @(controller == "N5Jobs" && action == "Recommended" ? "active" : "")" asp-controller="N5Jobs" asp-action="Recommended">Việc làm phù hợp</a>
                <a class="nav-link @(controller == "N5Profile" ? "active" : "")" asp-controller="N5Profile" asp-action="Edit">Hồ sơ</a>
                <a class="nav-link @(controller == "N5Applications" ? "active" : "")" asp-controller="N5Applications" asp-action="Index">Đơn đã gửi</a>
            }
            @if (employer)
            {
                <a class="nav-link @(controller == "N5Company" ? "active" : "")" asp-controller="N5Company" asp-action="Edit">Công ty</a>
                <a class="nav-link @(controller == "N5EmployerJobs" ? "active" : "")" asp-controller="N5EmployerJobs" asp-action="Index">Tin của tôi</a>
                <a class="nav-link @(controller == "N5Applications" ? "active" : "")" asp-controller="N5Applications" asp-action="Index">Ứng viên</a>
                <a class="nav-link @(controller == "N5Dashboard" ? "active" : "")" asp-controller="N5Dashboard" asp-action="Index">Tổng quan</a>
            }
            @if (admin)
            {
                <a class="nav-link @(controller == "N5Skills" ? "active" : "")" asp-controller="N5Skills" asp-action="Index">Danh mục kỹ năng</a>
            }
        </div>
        <div class="n5-account">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="dropdown">
                <button class="n5-avatar-button dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><span class="n5-avatar">@((User.Identity.Name ?? "N").Substring(0, 1).ToUpper())</span><span class="n5-role">@(employer ? "Nhà tuyển dụng" : admin ? "Quản trị viên" : "Ứng viên")</span></button>
                <div class="dropdown-menu dropdown-menu-end p-3">
                    <small class="text-muted d-block mb-2">@User.Identity.Name</small>
                    <form asp-controller="N5Account" asp-action="Logout" method="post"><button class="btn btn-light w-100">Đăng xuất</button></form>
                </div>
            </div>
        }
        else
        {
            <a class="n5-login-link" asp-controller="N5Account" asp-action="Login">Đăng nhập</a>
            <a class="btn btn-primary" asp-controller="N5Account" asp-action="Register">Tạo tài khoản <span aria-hidden="true">↗</span></a>
        }
        </div>
    </div>
</nav>
</header>
<main id="main">
@if (TempData["Success"] is string success)
{
    <div class="n5-container mt-3"><div class="alert alert-success" role="status">@success</div></div>
}
@if (TempData["Error"] is string error)
{
    <div class="n5-container mt-3"><div class="alert alert-danger" role="alert">@error</div></div>
}
@RenderBody()
</main>
<footer class="n5-footer"><div class="n5-container d-flex flex-wrap justify-content-between gap-3"><span><strong>RecruitHub</strong> · Kết nối kỹ năng với cơ hội.</span><span>Nhóm 5 · DT06 <span class="n5-footer-dot">•</span> Dự án học tập</span></div></footer>
<script src="~/lib/jquery.min.js"></script>
<script src="~/lib/jquery.validate.min.js" asp-append-version="true"></script>
<script src="~/lib/jquery.validate.unobtrusive.min.js" asp-append-version="true"></script>
<script src="~/lib/bootstrap.bundle.min.js"></script>
<script src="~/js/n5-site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

